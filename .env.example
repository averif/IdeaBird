NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# IdeaBird is vision-first: a vision model reads the screenshot itself and
# returns a structured understanding (summary, facts, metrics, stories, angles).
# Both models must be reachable with your key (check build.nvidia.com).
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MAX_TOKENS=3000

# Writes the posts from that understanding (text only, no image is re-sent).
# Must emit `content` within NVIDIA_MAX_TOKENS: reasoning models spend the token
# budget on hidden reasoning first, so a small max_tokens returns content:null.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct
# Hidden reasoning for the post writer (Nemotron). "off" took generation from
# 60s+ (and truncated JSON) to ~24s in testing. The vision step keeps reasoning.
NVIDIA_WRITER_THINKING=off

# Per-call limit. A model that hasn't answered by then is usually queued, so we
# move on to the next fallback model instead of retrying the same one.
NVIDIA_TIMEOUT_MS=60000
NVIDIA_MODEL_ATTEMPTS=1

# Total budget for one request (all model attempts). Defaults to 90s locally.
# The Vercel route defaults it to 55000 and clamps it under its 60s maxDuration.
# NVIDIA_TOTAL_TIMEOUT_MS=55000

# Budget must cover reasoning tokens + the real answer (~2.6k for a 5-post response).
NVIDIA_MAX_TOKENS=4096
# Reasoning depth for models that support it (gpt-oss): low | medium | high.
# "low" cut generation from 120s+ to ~48s in testing. Set empty to not send it.
NVIDIA_REASONING_EFFORT=low
# The misinformation check runs inside the vision analysis (no extra call).
PORT=3001

# --- Auth & database ---
# Postgres connection string (Neon: use the pooled URL with ?sslmode=require).
# For local dev without a Postgres server: pglite:./.data/ideabird (embedded, file-backed).
DATABASE_URL=
# Random secret of at least 32 characters for signing access tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating it logs everyone out.
JWT_SECRET=
# Public URL of the app. Email links are built from this, never from the request.
APP_URL=http://localhost:5173
# Google sign-in (Google Cloud Console > OAuth client ID, type "Web application").
# Add your app URL(s) under Authorized JavaScript origins. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# Transactional email via Resend (password reset, email verification). Without it,
# emails are printed to the server console in development and not sent in production.
RESEND_API_KEY=
MAIL_FROM=IdeaBird <onboarding@resend.dev>
# Generations allowed per user per hour.
GENERATE_RATE_LIMIT_PER_HOUR=30
