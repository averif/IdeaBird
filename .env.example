NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Must be a model your key can actually reach AND that emits `content` within
# NVIDIA_MAX_TOKENS. Reasoning models (gpt-oss, nemotron-*-reasoning) spend the
# token budget on hidden reasoning first — a small max_tokens returns content:null.
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b

# Reasoning models are slow. 90s is safe; 30s aborts healthy requests.
NVIDIA_TIMEOUT_MS=90000
NVIDIA_MODEL_ATTEMPTS=2

# Total budget for one request (moderation + all attempts). Unset = no cap locally.
# The Vercel route defaults it to 55000 and clamps it under its 60s maxDuration.
# NVIDIA_TOTAL_TIMEOUT_MS=55000

# Budget must cover reasoning tokens + the real answer (~2.6k for a 5-post response).
NVIDIA_MAX_TOKENS=4096
# Same reasoning cost applies to the one-word moderation answer.
NVIDIA_MODERATION_MAX_TOKENS=2048
PORT=3001
