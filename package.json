{
  "name": "ideabird",
  "version": "1.0.0",
  "description": "IdeaBird turns screenshot text into high-signal social content with NVIDIA NIM.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "tsx --test --test-concurrency=3 server/**/*.test.ts",
    "db:migrate": "tsx server/db/migrate.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "cookie-parser": "^1.4.7",
    "dodopayments": "^2.59.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.4"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
